# API Keys - Copy this file to .env and add your actual keys

# RapidAPI Key for JSearch
RAPIDAPI_KEY=your_rapidapi_key_here

# Optional: Other Job Search APIs
INDEED_API_KEY=your_indeed_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_key_here

# OpenAI API Key (optional, for LLM-based matching)
OPENAI_API_KEY=your_openai_key_here

# Configuration
SAMPLE_SIZE=7
